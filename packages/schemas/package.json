{
  "name": "@okrapdf/schemas",
  "version": "0.1.0",
  "description": "Shared Zod schemas and TypeScript types for okraPDF",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./document": "./src/document.ts",
    "./job": "./src/job.ts",
    "./parser-profile": "./src/parser-profile.ts",
    "./entity": "./src/entity.ts",
    "./export": "./src/export.ts",
    "./api": "./src/api.ts",
    "./socket": "./src/socket.ts",
    "./vendor": "./src/vendor.ts",
    "./document-url": "./src/document-url.ts",
    "./da-types": "./src/da-types.ts",
    "./vendor-plugin": "./src/vendor-plugin.ts",
    "./verification": "./src/verification.ts",
    "./cross-actor": "./src/cross-actor.ts",
    "./lineage": "./src/lineage.ts",
    "./export-snapshot": "./src/export-snapshot.ts",
    "./auth": "./src/auth.ts",
    "./collection": "./src/collection.ts",
    "./collection-query": "./src/collection-query.ts",
    "./document-ref": "./src/document-ref.ts",
    "./citation": "./src/citation.ts",
    "./page-resource": "./src/page-resource.ts",
    "./agent-config": "./src/agent-config.ts",
    "./pdf-source-context": "./src/pdf-source-context.ts",
    "./control-plane-protocol": "./src/control-plane-protocol.ts",
    "./opencode-dispatch": "./src/opencode-dispatch.ts",
    "./self-host": "./src/self-host.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okrapdf/schemas"
  },
  "homepage": "https://okrapdf.com",
  "author": "okraPDF",
  "keywords": [
    "pdf",
    "zod",
    "schemas",
    "types",
    "okrapdf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
