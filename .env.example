# okraPDF self-host server — copy to .env, set OKRA_API_KEY, then `docker compose up --build`.
#
# Everything below is LOCAL. There is no okraPDF cloud key here and the server
# never calls our cloud. State lives on the filesystem (OKRA_DATA_DIR) — no DB.

# Public port for the server (host side).
PORT=8787

# Base URL the server advertises to clients.
OKRA_BASE_URL=http://localhost:8787

# REQUIRED — local auth secret that gates the mutating routes (upload / workflows
# / runs). This is YOUR secret, not an okraPDF cloud key. Generate one:
#   openssl rand -hex 24
OKRA_API_KEY=

# First-owner bootstrap (single-owner mode). Registration stays invite-only.
OKRA_FIRST_OWNER_EMAIL=owner@example.com
OKRA_AUTH_MODE=single_owner
OKRA_REGISTRATION_MODE=invite_only

# Where uploaded PDFs + the document graph + run records are persisted.
OKRA_DATA_DIR=/data/okrapdf

# OPTIONAL — point parse/audit/redact at isolated capability services instead of
# the built-in in-process engines. Leave empty to use the local poppler+tesseract
# parser, basic WCAG audit, and basic PII redactor (zero external services).
OKRA_CAPABILITY_PARSER_MINERU_URL=
OKRA_CAPABILITY_AUDITOR_WCAG_BASIC_URL=
OKRA_CAPABILITY_REDACTOR_POLICY_BASIC_URL=
