{
  "id": "viewer.document-graph",
  "name": "Document Graph Viewer",
  "version": "0.1.0",
  "description": "Static viewer capability for pages, blocks, artifacts, findings, redactions, and lineage.",
  "kind": "viewer",
  "runtime": "http_base_url",
  "runtime_config": {
    "endpoint_path": "/ui/documents/:documentId"
  },
  "input_schema": {
    "type": "object",
    "required": ["document_id"],
    "properties": {
      "document_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "view_url": {
        "type": "string"
      }
    }
  },
  "reads": ["document", "pages", "blocks", "artifacts", "findings", "redactions", "lineage"],
  "writes": ["lineage"],
  "license": "MIT",
  "commercial_ok": true,
  "network_policy": {
    "mode": "restricted"
  },
  "isolation": {
    "namespace": "okra.capabilities.viewer.document-graph",
    "mode": "worker",
    "network_namespace": "none",
    "filesystem": {
      "read_only_root": true,
      "writable_paths": [],
      "volume_mounts": []
    },
    "secrets": {
      "scope": "none"
    },
    "notes": "Static app-shell route over existing graph records; no outbound network."
  },
  "offline_ok": true,
  "metadata": {
    "surface": "capability",
    "recipe_role": "viewer"
  }
}
