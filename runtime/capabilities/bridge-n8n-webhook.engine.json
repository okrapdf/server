{
  "id": "bridge.n8n.webhook",
  "name": "n8n Webhook Bridge",
  "version": "0.1.0",
  "description": "Receives external n8n webhook payloads and turns them into graph sources without embedding n8n orchestration.",
  "kind": "workflow_bridge",
  "runtime": "http_base_url",
  "runtime_config": {
    "endpoint_path": "/v1/sources/n8n"
  },
  "input_schema": {
    "type": "object"
  },
  "output_schema": {
    "$ref": "okra-document-graph/v1#/source"
  },
  "reads": ["source"],
  "writes": ["source", "lineage"],
  "secrets": [
    {
      "name": "OKRA_N8N_WEBHOOK_SECRET",
      "description": "Shared secret used to authenticate incoming n8n webhook payloads.",
      "required": false
    }
  ],
  "license": "MIT",
  "commercial_ok": true,
  "network_policy": {
    "mode": "restricted"
  },
  "isolation": {
    "namespace": "okra.capabilities.bridge.n8n-webhook",
    "mode": "worker",
    "network_namespace": "external",
    "filesystem": {
      "read_only_root": true,
      "writable_paths": [],
      "volume_mounts": []
    },
    "secrets": {
      "scope": "declared_only"
    },
    "notes": "External n8n calls enter through a declared bridge endpoint and external integration network; n8n is not embedded in the Okra runtime."
  },
  "offline_ok": false,
  "metadata": {
    "surface": "capability",
    "recipe_role": "workflow_bridge",
    "reference_templates": [
      "https://railway.com/deploy/n8n",
      "https://railway.com/deploy/n8n-with-workers"
    ]
  }
}
