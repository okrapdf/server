{
  "id": "review.a11y.findings",
  "name": "Accessibility Findings Review UI",
  "version": "0.1.0",
  "description": "Opens a review gate for accessibility findings before attestation or publish.",
  "kind": "review_ui",
  "runtime": "http_base_url",
  "runtime_config": {
    "endpoint_path": "/ui/reviews/a11y/:documentId"
  },
  "input_schema": {
    "type": "object",
    "required": ["document_id", "findings"],
    "properties": {
      "document_id": {
        "type": "string"
      },
      "findings": {
        "$ref": "okra-document-graph/v1#/findings"
      }
    }
  },
  "output_schema": {
    "$ref": "okra-document-graph/v1#/reviews"
  },
  "reads": ["document", "pages", "findings", "artifacts"],
  "writes": ["reviews", "lineage"],
  "license": "MIT",
  "commercial_ok": true,
  "network_policy": {
    "mode": "restricted"
  },
  "isolation": {
    "namespace": "okra.capabilities.review.a11y-findings",
    "mode": "worker",
    "network_namespace": "none",
    "filesystem": {
      "read_only_root": true,
      "writable_paths": [],
      "volume_mounts": []
    },
    "secrets": {
      "scope": "none"
    },
    "notes": "Human review route over local graph state; no outbound network."
  },
  "offline_ok": true,
  "metadata": {
    "surface": "capability",
    "recipe_role": "human_review"
  }
}
