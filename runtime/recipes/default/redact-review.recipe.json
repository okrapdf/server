{
  "schema_version": "okra-workflow-recipe/v1",
  "id": "recipe.redact-review",
  "name": "Redaction Review",
  "version": "0.1.0",
  "description": "Creates redaction proposals from a policy, opens a redaction review gate, and returns the document graph viewer.",
  "recipe_mode": "external",
  "triggers": ["manual_upload", "api_call", "mcp_tool"],
  "capability_refs": [
    "redactor.policy.basic",
    "review.redactions",
    "viewer.document-graph"
  ],
  "graph_contract": {
    "reads": ["document", "pages", "blocks", "regions", "findings"],
    "writes": ["redactions", "reviews", "artifacts", "lineage"]
  },
  "parameters_schema": {
    "type": "object",
    "required": ["policy"],
    "properties": {
      "policy": {
        "type": "object"
      },
      "review_required": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "steps": [
    {
      "id": "propose-redactions",
      "name": "Propose redactions",
      "uses": "redactor.policy.basic",
      "reads": ["document", "pages", "blocks", "regions", "findings"],
      "writes": ["redactions", "artifacts", "lineage"],
      "input_map": {
        "graph": "$.graph",
        "policy": "$.parameters.policy"
      }
    },
    {
      "id": "review-redactions",
      "name": "Open redaction review",
      "uses": "review.redactions",
      "reads": ["document", "pages", "redactions", "artifacts"],
      "writes": ["reviews", "lineage"],
      "requires_review": true,
      "on_error": "manual_review"
    },
    {
      "id": "view",
      "name": "Open graph viewer",
      "uses": "viewer.document-graph",
      "reads": ["document", "pages", "blocks", "artifacts", "redactions", "reviews", "lineage"],
      "writes": ["lineage"]
    }
  ],
  "labels": ["redaction", "human-review", "viewer"],
  "metadata": {
    "recipe_surface": "Product-facing redaction workflow over a policy capability and review UI."
  }
}
