{
  "schema_version": "okra-workflow-recipe/v1",
  "id": "recipe.audit-review",
  "name": "Audit Review",
  "version": "0.1.0",
  "description": "Runs an accessibility audit over an existing document graph, opens findings for review, and returns the document graph viewer.",
  "recipe_mode": "external",
  "triggers": ["manual_upload", "api_call", "mcp_tool"],
  "capability_refs": [
    "auditor.wcag.basic",
    "review.a11y.findings",
    "viewer.document-graph"
  ],
  "graph_contract": {
    "reads": ["document", "pages", "blocks", "artifacts"],
    "writes": ["findings", "reviews", "artifacts", "lineage"]
  },
  "parameters_schema": {
    "type": "object",
    "properties": {
      "standard": {
        "type": "string",
        "enum": ["wcag", "wcag2.2"],
        "default": "wcag"
      }
    }
  },
  "steps": [
    {
      "id": "audit",
      "name": "Audit accessibility",
      "uses": "auditor.wcag.basic",
      "reads": ["document", "pages", "blocks", "artifacts"],
      "writes": ["findings", "lineage"],
      "input_map": {
        "graph": "$.graph",
        "standard": "$.parameters.standard"
      },
      "on_error": "manual_review"
    },
    {
      "id": "review",
      "name": "Open accessibility review",
      "uses": "review.a11y.findings",
      "reads": ["document", "pages", "findings", "artifacts"],
      "writes": ["reviews", "lineage"],
      "requires_review": true,
      "on_error": "manual_review"
    },
    {
      "id": "view",
      "name": "Open graph viewer",
      "uses": "viewer.document-graph",
      "reads": ["document", "pages", "blocks", "artifacts", "findings", "reviews", "lineage"],
      "writes": ["lineage"]
    }
  ],
  "labels": ["a11y", "audit", "human-review", "viewer"],
  "metadata": {
    "recipe_surface": "Audit workflow entrypoint for `okra audit <docId> --standard wcag`."
  }
}
