{
  "schema_version": "okra-workflow-recipe/v1",
  "id": "recipe.hybrid-ocr-a11y-review",
  "name": "Hybrid OCR Accessibility Review",
  "version": "0.1.0",
  "description": "Ingests a document, runs a configurable OCR/parser capability, audits the normalized graph, opens findings for human review, and returns a viewer URL.",
  "recipe_mode": "external",
  "triggers": ["manual_upload", "api_call", "mcp_tool", "webhook"],
  "capability_refs": [
    "sourcer.local-upload",
    "parser.mineru",
    "parser.tesseract",
    "auditor.wcag.basic",
    "review.a11y.findings",
    "viewer.document-graph"
  ],
  "graph_contract": {
    "reads": ["source", "document", "pages", "blocks"],
    "writes": ["source", "document", "pages", "blocks", "artifacts", "findings", "reviews", "lineage"]
  },
  "parameters_schema": {
    "type": "object",
    "properties": {
      "ocr_strategy": {
        "type": "string",
        "enum": ["mineru", "tesseract", "vision_hybrid"],
        "default": "mineru"
      },
      "review_required": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "steps": [
    {
      "id": "ingest",
      "name": "Create source",
      "uses": "sourcer.local-upload",
      "reads": ["source"],
      "writes": ["source", "document", "artifacts", "lineage"],
      "input_map": {
        "file": "$.input.file",
        "metadata": "$.input.metadata"
      }
    },
    {
      "id": "parse",
      "name": "Parse document",
      "uses": "parser.mineru",
      "reads": ["source", "document"],
      "writes": ["pages", "blocks", "regions", "artifacts", "lineage"],
      "input_map": {
        "source": "$.graph.source",
        "strategy": "$.parameters.ocr_strategy"
      },
      "output_map": {
        "graph": "$.graph"
      }
    },
    {
      "id": "audit",
      "name": "Audit accessibility",
      "uses": "auditor.wcag.basic",
      "reads": ["document", "pages", "blocks", "artifacts"],
      "writes": ["findings", "lineage"],
      "on_error": "manual_review"
    },
    {
      "id": "review",
      "name": "Open accessibility review",
      "uses": "review.a11y.findings",
      "reads": ["document", "pages", "findings", "artifacts"],
      "writes": ["reviews", "lineage"],
      "requires_review": true,
      "on_error": "manual_review"
    },
    {
      "id": "view",
      "name": "Open graph viewer",
      "uses": "viewer.document-graph",
      "reads": ["document", "pages", "blocks", "artifacts", "findings", "reviews", "lineage"],
      "writes": ["lineage"]
    }
  ],
  "labels": ["ocr", "hybrid", "a11y", "human-review", "viewer"],
  "metadata": {
    "recipe_surface": "Product-facing workflow recipe. `parser.tesseract` is declared as the offline fallback capability for runtimes that map the parse step to an offline parser."
  }
}
