{
  "schema_version": "okra-workflow-recipe/v1",
  "id": "recipe.parse-document",
  "name": "Parse Document",
  "version": "0.1.0",
  "description": "Runs a configurable parser capability over an existing document graph and returns the document graph viewer.",
  "recipe_mode": "external",
  "triggers": ["manual_upload", "api_call", "mcp_tool"],
  "capability_refs": [
    "parser.mineru",
    "parser.tesseract",
    "viewer.document-graph"
  ],
  "graph_contract": {
    "reads": ["source", "document", "pages"],
    "writes": ["pages", "blocks", "regions", "artifacts", "lineage"]
  },
  "parameters_schema": {
    "type": "object",
    "properties": {
      "engine": {
        "type": "string",
        "enum": ["mineru", "tesseract", "vision_hybrid"],
        "default": "mineru"
      }
    }
  },
  "steps": [
    {
      "id": "parse",
      "name": "Parse document",
      "uses": "parser.mineru",
      "reads": ["source", "document"],
      "writes": ["pages", "blocks", "regions", "artifacts", "lineage"],
      "input_map": {
        "source": "$.graph.source",
        "engine": "$.parameters.engine"
      }
    },
    {
      "id": "view",
      "name": "Open graph viewer",
      "uses": "viewer.document-graph",
      "reads": ["document", "pages", "blocks", "artifacts", "lineage"],
      "writes": ["lineage"]
    }
  ],
  "labels": ["parser", "ocr", "viewer"],
  "metadata": {
    "recipe_surface": "Parser Hub workflow entrypoint for `okra parse <docId> --engine mineru`."
  }
}
