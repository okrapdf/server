{
  "schema_version": "okra-workflow-recipe/v1",
  "id": "recipe.n8n-ingest-audit-review",
  "name": "n8n Ingest Audit Review",
  "version": "0.1.0",
  "description": "Receives an external n8n webhook payload, parses the uploaded document, audits accessibility, opens review, and returns a viewer URL.",
  "recipe_mode": "external",
  "triggers": ["webhook"],
  "capability_refs": [
    "bridge.n8n.webhook",
    "parser.mineru",
    "auditor.wcag.basic",
    "review.a11y.findings",
    "viewer.document-graph"
  ],
  "graph_contract": {
    "reads": ["source", "document", "pages", "blocks", "regions", "artifacts", "findings", "reviews", "lineage"],
    "writes": ["source", "pages", "blocks", "regions", "artifacts", "findings", "reviews", "lineage"]
  },
  "parameters_schema": {
    "type": "object",
    "properties": {
      "webhook_name": {
        "type": "string"
      }
    }
  },
  "steps": [
    {
      "id": "receive-webhook",
      "name": "Receive n8n payload",
      "uses": "bridge.n8n.webhook",
      "reads": ["source"],
      "writes": ["source", "lineage"],
      "input_map": {
        "payload": "$.input",
        "label": "$.parameters.webhook_name"
      }
    },
    {
      "id": "parse",
      "name": "Parse document",
      "uses": "parser.mineru",
      "reads": ["source", "document"],
      "writes": ["pages", "blocks", "regions", "artifacts", "lineage"]
    },
    {
      "id": "audit",
      "name": "Audit accessibility",
      "uses": "auditor.wcag.basic",
      "reads": ["document", "pages", "blocks", "artifacts"],
      "writes": ["findings", "lineage"]
    },
    {
      "id": "review",
      "name": "Open accessibility review",
      "uses": "review.a11y.findings",
      "reads": ["document", "pages", "findings", "artifacts"],
      "writes": ["reviews", "lineage"],
      "requires_review": true,
      "on_error": "manual_review"
    },
    {
      "id": "view",
      "name": "Open graph viewer",
      "uses": "viewer.document-graph",
      "reads": ["document", "pages", "blocks", "artifacts", "findings", "reviews", "lineage"],
      "writes": ["lineage"]
    }
  ],
  "labels": ["n8n", "webhook", "ocr", "a11y", "human-review"],
  "metadata": {
    "recipe_surface": "External n8n workflow integration. n8n stays outside the Okra runtime and enters through the webhook bridge."
  }
}
