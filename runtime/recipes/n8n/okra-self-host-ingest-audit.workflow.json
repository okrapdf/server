{
  "name": "Okra self-host ingest audit review",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "okra/ingest-audit-review",
        "responseMode": "responseNode",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "x-okra-recipe",
                "value": "recipe.n8n-ingest-audit-review"
              }
            ]
          }
        }
      },
      "id": "6a3aab0f-ec0f-4dc1-9013-9ba7d33e3c2a",
      "name": "Receive document payload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "okra-self-host-ingest-audit"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OKRA_BASE_URL + \"/v1/sources/n8n\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "={{\"Bearer \" + $env.OKRA_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-okra-webhook-secret",
              "value": "={{$env.OKRA_N8N_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: $json, recipe_id: \"recipe.n8n-ingest-audit-review\", received_by: \"n8n\" }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "911afcd3-cd51-4713-9ef4-00dd298ff4f7",
      "name": "Register Okra source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OKRA_BASE_URL + \"/v1/workflows\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "={{\"Bearer \" + $env.OKRA_API_KEY}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipe_id: \"recipe.n8n-ingest-audit-review\", source_id: $(\"Register Okra source\").item.json.id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "f5cde8c4-4491-42a1-a310-9d09ee9407f7",
      "name": "Start Okra recipe run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, recipe_id: \"recipe.n8n-ingest-audit-review\", source: $(\"Register Okra source\").item.json, run: $(\"Start Okra recipe run\").item.json }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "74f9e9ee-2baf-43b0-9db3-a6a71bb16c4c",
      "name": "Return Okra run",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Receive document payload": {
      "main": [
        [
          {
            "node": "Register Okra source",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Okra source": {
      "main": [
        [
          {
            "node": "Start Okra recipe run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Okra recipe run": {
      "main": [
        [
          {
            "node": "Return Okra run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
